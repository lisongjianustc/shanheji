  "interpretations": [
    {
      "id": "kanguole-661-disputed",
      "label": "Kanguole 661年图幅（争议版）",
      "reason": "按来源图幅分离民政、军事行政与西部主张；原图准确性有争议。行政范围不表示持续实控，默认不显示主张。",
      "evidence": [
        {
          "sourceId": "commons-kanguole-tang-661",
          "locator": "Summary、Map legend、Geotemporal data、Licensing及Disputed标注",
          "note": "只复核来源图幅与坐标转换，未独立验证书籍原图。"
        }
      ]
    },
    {
      "id": "zhoudadudu-262-administration",
      "label": "Zhoudadudu 262年州郡图（行政参考）",
      "reason": "按原图16项州域颜色归并魏蜀吴；行政区划不表示实控。图例、几何和配准复核，未核原地图集。",
      "evidence": [
        {
          "sourceId": "commons-three-kingdoms-262",
          "locator": "262年图标题、图例与轮廓；data/registration/及data/audits/编制记录",
          "note": "仅复核来源一致性，未经历史专家审定。"
        }
      ]
    },
    {
      "id": "sy-572-administration",
      "label": "SY 572年州域图（争议参考）",
      "reason": "沿粗虚线编制北周、北齐、陈与江陵西梁；海岸用原图陆地色。来源未给所据历史图幅，海南、台湾、交趾及邻国不赋归属。",
      "evidence": [
        {
          "sourceId": "commons-china-572",
          "locator": "572年图标题、图例与轮廓；data/registration/及data/audits/编制记录",
          "note": "仅复核来源一致性，未经历史专家审定。"
        }
      ]
    },
    {
      "id": "yug-610-partial-administration",
      "label": "Yug约610年隋朝图（部分行政参考）",
      "reason": "只编制原SVG填色与描边都完全不透明、且在画布内的部分。西部渐隐和画布外未录入，裁切边线不绘制国界；六湖拟合、四湖独立检查，最大残差约47公里。未核原书图幅，未完成周边政权，不表示全年实控。",
      "evidence": [
        {
          "sourceId": "commons-china-610",
          "locator": "SVG Sui ~610；linearGradient7461、linearGradient8438；Commons Summary西部blur说明",
          "note": "仅编制两条渐隐梯度均完全不透明的部分，并限制在原画布；不补齐模糊西部，不把资料裁切线作为历史国界。"
        },
        {
          "sourceId": "natural-earth-registration-lakes",
          "locator": "六个拟合湖泊、四个独立检验湖泊；data/registration/sui-610.json",
          "note": "只用于近似配准现代自然地理，不提供隋朝历史疆界。"
        }
      ]
    },
    {
      "id": "yug-742-eastern-administration",
      "label": "Yug 742年图（东部行政参考）",
      "reason": "仅编制105°E以东及原画布内范围，西部高宗时期及约750年来源不拼接。裁切线不绘制国界；六湖拟合四湖检查，最大残差约47公里，不表示历史精度。未核原书，未经历史专家审定。",
      "evidence": [
        {
          "sourceId": "commons-china-742",
          "locator": "Commons Summary: main part, Cambridge History Vol.3 map11 p.403; SVG Tang742/path6536",
          "note": "仅105°E以东来源行政参考；西部采用图8和约750年地图，全部排除。105°E是编制裁切限度，不是历史边界。未独立核对原书。"
        },
        {
          "sourceId": "natural-earth-registration-lakes",
          "locator": "data/registration/tang-742.json；六湖拟合、四湖独立检查",
          "note": "逐湖重读本SVG重心；现代湖泊只作配准，不生成历史边界。"
        }
      ]
    }
